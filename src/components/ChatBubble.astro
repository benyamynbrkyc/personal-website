---
import { Image } from 'astro:assets';
import profile from '../assets/images/profile.webp';
import { site } from '../data/site';
---

<header class='chat mx-auto max-w-sm'>
  <div class='chat-bubble sticky top-6 max-w-sm pt-6 text-left text-base md:top-12 md:pt-7 md:text-xl'>
    <div class='animate-fade-in-up rounded-2xl bg-linear-to-b from-blue-500 to-blue-600 px-6 py-4 text-white shadow-xl'>
      <h1>
        Hi, my name is Benjamin! 👋
        <br />
        I&apos;m a full-stack developer building web, mobile, and real-time
        products.
        <br />
        Nice to meet you 😄
      </h1>
    </div>
  </div>
  <div class='chat-avatar'>
    <Image
      src={profile}
      alt={`Portrait of ${site.name}`}
      width={80}
      height={80}
      densities={[1, 2]}
      priority
      class='w-20 rounded-full border-8 border-white shadow-lg dark:border-black'
    />
  </div>
</header>

<style>
  .chat-bubble {
    animation: bubble-pop 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .chat-avatar {
    animation: avatar-in 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.7s both;
  }

  @media (min-width: 640px) and (hover: hover) {
    .chat {
      transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .chat:hover {
      transform: translateX(30px) scale(1.1);
    }
  }

  @keyframes bubble-pop {
    0% {
      transform: translateY(50px) scale(0.85);
    }

    55% {
      transform: translateY(0) scale(1.1);
    }

    100% {
      transform: translateY(0) scale(1);
    }
  }

  @keyframes avatar-in {
    from {
      opacity: 0;
      transform: translateY(0);
    }

    to {
      opacity: 1;
      transform: translateY(-10px);
    }
  }
</style>
