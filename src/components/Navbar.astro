---
import { pagePath } from '../data/site';

const links = [
  { href: '/', label: 'Home' },
  { href: '/work', label: 'Work' },
];

const pathname = pagePath(Astro.url);
---

<nav aria-label='Main' class='p-8 pt-12 text-2xl text-black dark:text-white'>
  <ul class='flex items-center justify-center gap-8'>
    {links.map(({ href, label }) => (
      <li>
        <a
          href={href}
          aria-current={pathname === href ? 'page' : undefined}
          class='transition-colors hover:text-blue-500 aria-[current=page]:text-blue-500'>
          {label}
        </a>
      </li>
    ))}
  </ul>
</nav>
