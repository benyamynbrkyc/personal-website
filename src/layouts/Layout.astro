---
import BaseHead, {
  type Props as HeadProps,
} from '../components/BaseHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

type Props = HeadProps;
---

<!doctype html>
<html lang='en'>
  <head>
    <BaseHead {...Astro.props} />
  </head>
  <body class='flex flex-col'>
    <a
      href='#content'
      class='sr-only rounded-lg bg-blue-600 px-4 py-2 text-white focus:not-sr-only focus:absolute focus:top-4 focus:left-4'>
      Skip to content
    </a>
    <Navbar />
    <main id='content' class='mx-auto w-full max-w-2xl grow px-4 pt-10'>
      <slot />
    </main>
    <Footer />
  </body>
</html>
