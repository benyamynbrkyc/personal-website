---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---

<Layout
  title={`Page not found | ${site.name}`}
  description='The page you are looking for does not exist.'
  noindex>
  <div class='flex flex-col items-center gap-6 py-20 text-center'>
    <p class='text-sm font-medium tracking-widest text-blue-600 uppercase dark:text-blue-400'>
      404
    </p>
    <h1 class='text-4xl font-bold tracking-tight'>Page not found</h1>
    <p class='text-lg text-gray-700 dark:text-gray-300'>
      The page you are looking for does not exist or has moved.
    </p>
    <a
      href='/'
      class='rounded-2xl bg-linear-to-b from-blue-500 to-blue-600 px-6 py-3 text-white shadow-xl transition-transform hover:scale-[1.02]'>
      Back to home
    </a>
  </div>
</Layout>
